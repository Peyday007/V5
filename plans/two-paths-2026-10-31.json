{
  "version": 1,
  "title": "Two paths on one email capacity: mailer spots and website fixes",
  "claim": "ANALYSIS",
  "goal": {
    "metric": "SETTLED_CASH",
    "target": 10000,
    "unit": "USD",
    "deadlineDays": 25,
    "capitalCeiling": 3000,
    "preFirstPaymentCeiling": 300,
    "goalId": "wst_7b4fcbb5f2384f31b6c3"
  },
  "model": {
    "title": "Mailer plus website fixes",
    "currency": "USD",
    "horizon": "the 25 days to the goal deadline",
    "variables": [
      {
        "key": "spot_price",
        "label": "Price of one ad spot on one mailing (market rate, not yet ours)",
        "unit": "USD/spot",
        "provenance": "EVIDENCE",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 150
        },
        "sources": [
          {
            "kind": "URL",
            "ref": "https://pod.wave.co/podcast/the-side-hustle-show/719-1000-per-postcard-the-every-door-direct-mail-side-hustle"
          }
        ]
      },
      {
        "key": "spots_per_card",
        "label": "Ad spots on one card",
        "unit": "spot/card",
        "provenance": "EVIDENCE",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 16
        },
        "sources": [
          {
            "kind": "URL",
            "ref": "https://pod.wave.co/podcast/the-side-hustle-show/719-1000-per-postcard-the-every-door-direct-mail-side-hustle"
          }
        ]
      },
      {
        "key": "cost_per_card",
        "label": "Print, EDDM postage and fulfilment for one card to about 2,500 homes",
        "unit": "USD/card",
        "provenance": "EVIDENCE",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 1300
        },
        "sources": [
          {
            "kind": "URL",
            "ref": "https://pod.wave.co/podcast/the-side-hustle-show/719-1000-per-postcard-the-every-door-direct-mail-side-hustle"
          },
          {
            "kind": "URL",
            "ref": "https://v2.4over4.com/guide/eddm-pricing-explained",
            "note": "postage $0.26 a piece"
          }
        ]
      },
      {
        "key": "cards",
        "label": "Cards (cities) opened",
        "unit": "card",
        "provenance": "ASSUMPTION",
        "controllable": true,
        "spec": {
          "kind": "RANGE",
          "min": 1,
          "max": 8
        }
      },
      {
        "key": "reply_rate",
        "label": "Interested replies per business contacted",
        "unit": "reply/contact",
        "provenance": "UNKNOWN",
        "controllable": false,
        "spec": {
          "kind": "RANGE",
          "min": 0.005,
          "max": 0.05
        }
      },
      {
        "key": "close_rate",
        "label": "Spots sold per interested reply",
        "unit": "spot/reply",
        "provenance": "UNKNOWN",
        "controllable": false,
        "spec": {
          "kind": "RANGE",
          "min": 0.05,
          "max": 0.3
        }
      },
      {
        "key": "inboxes",
        "label": "Sending inboxes",
        "unit": "inbox",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 10
        }
      },
      {
        "key": "sends_per_inbox_day",
        "label": "Cold emails per inbox per day",
        "unit": "contact/inbox/day",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 30
        }
      },
      {
        "key": "selling_days",
        "label": "Days spent selling",
        "unit": "day",
        "provenance": "ASSUMPTION",
        "controllable": true,
        "spec": {
          "kind": "RANGE",
          "min": 1,
          "max": 25
        }
      },
      {
        "key": "settle_days",
        "label": "Days from card payment to settled cash",
        "unit": "day",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 2
        }
      },
      {
        "key": "lead_cost",
        "label": "Lead lists bought before any sale",
        "unit": "USD",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 100
        }
      },
      {
        "key": "goal_target",
        "label": "The goal's target",
        "unit": "USD",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 10000
        }
      },
      {
        "key": "web_share",
        "label": "Share of sending capacity spent on website-fix offers",
        "unit": "1",
        "provenance": "ASSUMPTION",
        "controllable": true,
        "spec": {
          "kind": "RANGE",
          "min": 0,
          "max": 1
        }
      },
      {
        "key": "web_price",
        "label": "Price of one website fix (not yet established)",
        "unit": "USD/fix",
        "provenance": "UNKNOWN",
        "controllable": false,
        "spec": {
          "kind": "RANGE",
          "min": 150,
          "max": 600
        }
      },
      {
        "key": "web_reply_rate",
        "label": "Interested replies per business offered a fix",
        "unit": "reply/contact",
        "provenance": "UNKNOWN",
        "controllable": false,
        "spec": {
          "kind": "RANGE",
          "min": 0.005,
          "max": 0.05
        }
      },
      {
        "key": "web_close_rate",
        "label": "Fixes sold per interested reply",
        "unit": "fix/reply",
        "provenance": "UNKNOWN",
        "controllable": false,
        "spec": {
          "kind": "RANGE",
          "min": 0.05,
          "max": 0.3
        }
      },
      {
        "key": "web_fix_cost",
        "label": "Cost to deliver one fix (Brain does the work)",
        "unit": "USD/fix",
        "provenance": "ASSUMPTION",
        "controllable": false,
        "spec": {
          "kind": "FIXED",
          "value": 0
        }
      }
    ],
    "derived": [
      {
        "key": "capacity",
        "label": "Sending capacity",
        "unit": "contact",
        "expr": "inboxes * sends_per_inbox_day * selling_days"
      },
      {
        "key": "web_contacts",
        "label": "Businesses offered a website fix",
        "unit": "contact",
        "expr": "floor(capacity * web_share)"
      },
      {
        "key": "contacts",
        "label": "Businesses offered a mailer spot",
        "unit": "contact",
        "expr": "capacity - web_contacts"
      },
      {
        "key": "replies",
        "label": "Interested replies",
        "unit": "reply",
        "expr": "floor(contacts * reply_rate)"
      },
      {
        "key": "card_slots",
        "label": "Spots available across every card",
        "unit": "spot",
        "expr": "cards * spots_per_card"
      },
      {
        "key": "spots_sold",
        "label": "Spots sold",
        "unit": "spot",
        "expr": "min(floor(replies * close_rate), card_slots)"
      },
      {
        "key": "collected",
        "label": "Collected and settled",
        "unit": "USD",
        "expr": "spots_sold * spot_price"
      },
      {
        "key": "cards_mailed",
        "label": "Cards that must be mailed",
        "unit": "card",
        "expr": "ceil(spots_sold / spots_per_card)"
      },
      {
        "key": "fulfilment",
        "label": "Cost of every mailing sold",
        "unit": "USD",
        "expr": "cards_mailed * cost_per_card"
      },
      {
        "key": "pre_payment",
        "label": "Spent before the first payment",
        "unit": "USD",
        "expr": "lead_cost"
      },
      {
        "key": "days_to_settled",
        "label": "Days until the last payment settles",
        "unit": "day",
        "expr": "selling_days + settle_days"
      },
      {
        "key": "assumed_sale_rate",
        "label": "Spots sold per contact, assumed",
        "unit": "spot/contact",
        "expr": "reply_rate * close_rate"
      },
      {
        "key": "spots_needed",
        "label": "Spots the target needs",
        "unit": "spot",
        "expr": "ceil(goal_target / spot_price)"
      },
      {
        "key": "mailer_only_needed_rate",
        "label": "Spots per contact the target needs",
        "unit": "spot/contact",
        "expr": "spots_needed / capacity"
      },
      {
        "key": "web_replies",
        "label": "Website-fix replies",
        "unit": "reply",
        "expr": "floor(web_contacts * web_reply_rate)"
      },
      {
        "key": "fixes_sold",
        "label": "Website fixes sold",
        "unit": "fix",
        "expr": "floor(web_replies * web_close_rate)"
      },
      {
        "key": "web_collected",
        "label": "Website fixes collected",
        "unit": "USD",
        "expr": "fixes_sold * web_price"
      },
      {
        "key": "web_cost",
        "label": "Cost of fixes owed",
        "unit": "USD",
        "expr": "fixes_sold * web_fix_cost"
      },
      {
        "key": "total_collected",
        "label": "Collected from both paths",
        "unit": "USD",
        "expr": "collected + web_collected"
      },
      {
        "key": "peak_exposure",
        "label": "Owner money at risk at once",
        "unit": "USD",
        "expr": "lead_cost + max(0, fulfilment + web_cost - total_collected)"
      }
    ],
    "lines": [
      {
        "key": "sales",
        "label": "Spot sales",
        "kind": "REVENUE",
        "expr": "collected"
      },
      {
        "key": "fulfilment_cost",
        "label": "Printing, postage, fulfilment",
        "kind": "COST",
        "expr": "fulfilment"
      },
      {
        "key": "leads",
        "label": "Lead lists",
        "kind": "COST",
        "expr": "lead_cost"
      },
      {
        "key": "web_sales",
        "label": "Website fixes",
        "kind": "REVENUE",
        "expr": "web_collected"
      },
      {
        "key": "web_delivery",
        "label": "Website fix delivery",
        "kind": "COST",
        "expr": "web_cost"
      }
    ],
    "strategies": [
      {
        "key": "split",
        "label": "Five mailer cards, half the sending on website fixes",
        "set": {
          "cards": 5,
          "selling_days": 20,
          "web_share": 0.5
        }
      }
    ]
  },
  "strategy": "split",
  "point": {
    "reply_rate": 0.03,
    "close_rate": 0.2,
    "web_price": 400,
    "web_reply_rate": 0.03,
    "web_close_rate": 0.2
  },
  "roles": {
    "outcome": "total_collected",
    "daysToOutcome": "days_to_settled",
    "peakExposure": "peak_exposure",
    "preFirstPaymentSpend": "pre_payment"
  },
  "bounds": [
    {
      "label": "Spots sold fit on the cards",
      "quantity": "spots_sold",
      "atMost": "card_slots"
    },
    {
      "label": "Both offers fit in one sending capacity",
      "quantity": "web_contacts",
      "atMost": "capacity"
    }
  ],
  "obligations": [
    {
      "label": "Each spot sold is one mailing owed",
      "revenueLine": "sales",
      "costLine": "fulfilment_cost",
      "costDerived": "fulfilment"
    },
    {
      "label": "Each fix sold is work owed",
      "revenueLine": "web_sales",
      "costLine": "web_delivery",
      "costDerived": "web_cost"
    }
  ],
  "checkpoints": [],
  "narrative": "Splitting the same 6,000 sends in half between mailer spots and website fixes, at the same assumed 3% reply and 20% close rates, sells 18 spots ($2,700) and 18 fixes at an unconfirmed $400 ($7,200): $9,900 collected, short of the $10,000 target. Money at risk stays at $100. Across the tested ranges the target is met in 21.9% of conditions, which is coverage of guesses, not a probability."
}
