# Brain — cloud persistence configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this example file is not,
# and must never contain a real value.
#
# Loaded automatically by `npm run dev`, `npm start` and `npm run migrate:cloud`
# (Node's --env-file-if-exists). Nothing here reaches the browser: the client is
# a static bundle that talks only to Brain's own API.
#
# Leave the whole file absent to run locally against SQLite and a document
# folder, which needs no configuration at all.

# --- Database ---------------------------------------------------------------
BRAIN_DATABASE_PROVIDER=postgres
# Supabase: Project settings -> Database -> Connection string.
# Use the SESSION POOLER string if several Brain instances will run at once.
# TLS is required unless the URL says otherwise; add ?sslmode=disable only for
# a local Postgres with no TLS, and only deliberately.
BRAIN_DATABASE_URL=
# Optional, 1-100, default 10.
# BRAIN_DATABASE_POOL_SIZE=10

# --- Documents --------------------------------------------------------------
BRAIN_STORAGE_PROVIDER=supabase
# Project settings -> API -> Project URL. Must be https.
SUPABASE_URL=
# Project settings -> API -> service_role key. NOT the anon key: the anon key
# cannot write. This is a full-access bearer token — server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Storage -> the bucket's name. It must be PRIVATE.
BRAIN_STORAGE_BUCKET=brain

# --- The first administrator ------------------------------------------------
# Read once, into a Brain that has no accounts at all, and ignored ever after.
# This is the only way into a new installation: without it nobody can sign in,
# and there is deliberately no default account and no unauthenticated setup page.
#
# The password is temporary by construction — it exists in this file and in your
# deployment platform's secret store, so the account is created owing a password
# change and can do nothing else until it has been made. Remove both variables
# once the first person has signed in.
BRAIN_BOOTSTRAP_ADMIN_EMAIL=
BRAIN_BOOTSTRAP_ADMIN_PASSWORD=
# Optional; defaults to the email address.
# BRAIN_BOOTSTRAP_ADMIN_NAME=

# --- Optional outer layer ---------------------------------------------------
# One shared credential in front of the whole site, checked before anything else.
# This is NOT what protects the Brain — accounts are (docs/IDENTITY.md). It is a
# second, cruder lock for a deployment that should not be discoverable at all,
# and it is off unless you set it. Generate it, do not choose it:
#   openssl rand -base64 32
BRAIN_ACCESS_TOKEN=
# Optional. Cosmetic only: the username in the browser prompt is not checked.
# BRAIN_ACCESS_USER=brain

# --- Tests ------------------------------------------------------------------
# Set to run the whole suite against Postgres instead of SQLite.
# BRAIN_TEST_DATABASE_URL=
