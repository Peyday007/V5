# Copy to .env (cp env.example .env) and adjust. Everything here is read by the server only;
# nothing reaches the browser.

# Port the tutor web server listens on.
TUTOR_PORT=8790
# Where saved decks, the card cache and match records live.
TUTOR_DATA_DIR=./data

# The Forge bridge (started with `npm run bridge`). Local only.
FORGE_BRIDGE_URL=http://127.0.0.1:8765

# Optional: live coaching from a language model. Without a key the tutor still lists legal
# options, explains engine refusals, explains cards and rules, and gives rule-of-thumb hints,
# but says plainly that model coaching is not configured.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5

# Identifies this app to Scryfall, as its API terms require.
SCRYFALL_USER_AGENT=MTGDeckTutor/0.1
