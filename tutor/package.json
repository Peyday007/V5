{
  "name": "mtg-deck-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn the Magic: The Gathering deck you own: import it, study it, and practice against Forge's AI with a tutor.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "forge:setup": "sh forge/setup.sh",
    "bridge": "sh bridge/run.sh",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cards:sync": "tsx --env-file-if-exists=.env scripts/sync-cards.ts",
    "walkthrough": "tsx --env-file-if-exists=.env scripts/walkthrough.ts",
    "scenarios": "tsx --env-file-if-exists=.env scripts/scenarios.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "playwright-core": "1.56.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
