{
  "name": "brain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Brain \u2014 local-first research operations platform (project state, dependencies, prompts, audits, synthesis, freeze).",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:reset": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('data/brain.db',{force:true});rmSync('data/brain.db-wal',{force:true});rmSync('data/brain.db-shm',{force:true});console.log('database removed')\"",
    "migrate:cloud": "tsx --env-file-if-exists=.env scripts/migrate-cloud.ts",
    "start:container": "node --import tsx server/index.ts",
    "verify:hosted": "node --import tsx scripts/verify-hosted.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "reissue:verification": "tsx scripts/reissue-verification.ts",
    "authorize:gap-policy": "tsx scripts/authorize-gap-policy.ts",
    "report:packet": "tsx scripts/packet-report.ts",
    "verify:capability": "tsx scripts/verify-research-capability.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "mammoth": "^1.12.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
